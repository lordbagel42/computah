{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "clientMutationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100000,
      "pattern": "\\S"
    }
  },
  "required": ["clientMutationId", "text"],
  "additionalProperties": false,
  "$defs": {}
}
