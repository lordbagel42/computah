{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "enum": [1]
    },
    "actorId": {
      "type": "string",
      "minLength": 1
    },
    "availability": {
      "type": "string",
      "enum": ["present", "missing"]
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "submissionId": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "role": {
            "type": "string",
            "enum": ["user", "assistant", "system"]
          },
          "createdAt": {
            "type": "string"
          },
          "revision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "blocks": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "kind": {
                      "type": "string",
                      "enum": ["text"]
                    },
                    "text": {
                      "type": "string"
                    }
                  },
                  "required": ["id", "kind", "text"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "kind": {
                      "type": "string",
                      "enum": ["component"]
                    },
                    "component": {
                      "type": "string",
                      "minLength": 1
                    },
                    "componentVersion": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "props": {
                      "type": "object"
                    },
                    "fallback": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "kind",
                    "component",
                    "componentVersion",
                    "props",
                    "fallback"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          }
        },
        "required": [
          "id",
          "submissionId",
          "role",
          "createdAt",
          "revision",
          "blocks"
        ],
        "additionalProperties": false
      }
    },
    "nextCursor": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "truncatedMessageIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "version",
    "actorId",
    "availability",
    "messages",
    "nextCursor",
    "truncatedMessageIds",
    "limitations"
  ],
  "additionalProperties": false,
  "$defs": {}
}
