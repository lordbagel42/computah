{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "alias": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["pending", "ready", "needs-human", "unknown", "revoked", "error"]
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": ["id", "alias", "status", "capabilities"],
  "additionalProperties": false,
  "$defs": {}
}
