#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."
export PATH="$HOME/.local/share/computah-toolchain/node/bin:$HOME/.local/share/computah-toolchain/bin:$HOME/.cargo/bin:$PATH"

# Local checks only: never download packages or authenticate during resume.
node_version="$(sed -nE 's/^FROM node:([0-9.]+)-.*/\1/p' Dockerfile)"
[[ "$(node --version)" == "v$node_version" ]]
pnpm_version="$(node -p 'require("./package.json").packageManager.split("@")[1]')"
[[ "$(pnpm --version)" == "$pnpm_version" ]]
for workspace in apps/native experiments/rune-pi; do
  rust_version="$(sed -nE 's/^channel = "([^"]+)"/\1/p' "$workspace/rust-toolchain.toml")"
  rustup run "$rust_version" rustc --version
done
echo '[orb resume] Toolchains available; no services or credentials required for local checks'
