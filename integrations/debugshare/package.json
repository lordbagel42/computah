    "test": "node --test worker.test.mjs",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "1.7.18",
    "@modelcontextprotocol/sdk": "1.32.2",
    "apps": "0.0.1-beta.122",
    "better-auth": "1.7.18",
    "clsx": "2.1.1",
    "lucide-svelte": "1.0.1",
    "svelte": "5.57.3",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261109.1",
    "@sveltejs/adapter-cloudflare": "7.2.10",
    "@sveltejs/kit": "2.70.4",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "^24.0.0",
    "svelte-check": "4.7.8",
    "tailwindcss": "4.3.5",
    "typescript": "^6.0.0",
    "vite": "8.3.7",
    "wrangler": "4.158.0"
  }
