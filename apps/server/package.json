{
  "name": "@computah/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/core.ts"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc --ignoreConfig --noEmit --strict --skipLibCheck --target es2023 --module nodenext src/*.ts test/*.ts vitest.config.ts"
  },
  "dependencies": {
    "@computah/contracts": "workspace:*",
    "@computah/observability": "workspace:*",
    "@durable-streams/server": "0.3.9",
    "@earendil-works/chord": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-durable": "1.5.0",
    "@earendil-works/pi-mcp": "1.5.0",
    "@earendil-works/pi-schema": "1.5.0",
    "@earendil-works/pi-telemetry": "1.5.0",
    "@rivet-dev/agentos-core": "0.4.7",
    "@rivet-dev/pi": "0.5.6",
    "effect": "4.1.2",
    "rivetkit": "3.0.6",
    "tsx": "4.21.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "typescript": "7.0.2",
    "vitest": "3.2.4"
  }
}
