{
  "display_information": {
    "name": "Computah",
    "description": "Per-user durable Computah conversations"
  },
  "features": {
    "bot_user": { "display_name": "Computah", "always_online": false },
    "app_home": {
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": false
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "im:history",
        "im:write",
        "chat:write",
        "channels:history",
        "groups:history",
        "mpim:history"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "app_mention",
        "message.im",
        "message.channels",
        "message.groups",
        "message.mpim"
      ]
    },
    "socket_mode_enabled": true,
    "org_deploy_enabled": true,
    "token_rotation_enabled": false
  }
}
